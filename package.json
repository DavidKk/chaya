{
  "name": "chaya",
  "version": "0.0.2",
  "private": true,
  "description": "Local-first RPG Maker translation and toolkit",
  "author": "DavidJones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidKk/chaya.git"
  },
  "homepage": "https://github.com/DavidKk/chaya",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "node scripts/dev.mjs --app",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:loopback": "node scripts/dev.mjs --loopback",
    "electron": "CHAYA_SERVICE=app electron .",
    "electron:open": "CHAYA_SERVICE=app CHAYA_ELECTRON_EXTERNAL=1 electron .",
    "build:native": "sh native/apple-translator/build.sh",
    "build:bergamot": "sh native/bergamot-translator/build.sh",
    "build": "pnpm build:native && pnpm build:plugins && pnpm build:next",
    "build:next": "pnpm build:translate && next build --webpack",
    "build:cloud": "cross-env CHAYA_TARGET=cloud pnpm build",
    "check:cloud": "pnpm build:cloud && node scripts/check-cloud-build.mjs",
    "build:plugins": "node plugins/build.mjs",
    "build:plugins:dev": "node plugins/build.mjs --watch",
    "build:app": "cross-env CHAYA_ELECTRON_BUILD=1 CHAYA_SERVICE=app pnpm build && node scripts/prepare-electron-app.mjs",
    "dist:mac": "node scripts/dist.mjs --mac",
    "dist:win": "node scripts/dist.mjs --win",
    "dist:dir": "node scripts/dist.mjs --dir",
    "demo:game": "pnpm build:plugins && node scripts/demo-game.cjs",
    "demo:walk": "pnpm build:plugins && node scripts/demo-game.cjs walk",
    "demo:rgss": "tsx scripts/demo-rgss.ts",
    "start": "node scripts/start.mjs",
    "start:lan": "node scripts/start.mjs --lan",
    "start:loopback": "node scripts/start.mjs --loopback",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit && pnpm typecheck:plugins",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --config .prettierrc.cjs --write \"**/*.{js,jsx,cjs,ts,tsx,md,json,yml,yaml,mjs,css}\"",
    "format:check": "prettier --config .prettierrc.cjs --check \"**/*.{js,jsx,cjs,ts,tsx,md,json,yml,yaml,mjs,css}\"",
    "lint": "eslint -c eslint.config.mjs --fix .",
    "lint:check": "eslint -c eslint.config.mjs .",
    "ok": "pnpm format && pnpm lint && pnpm typecheck && pnpm test -- --runInBand && pnpm build",
    "ok:full": "pnpm ok",
    "ok:ci": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm test -- --runInBand && pnpm build",
    "translate": "tsx services/translate/cli.ts",
    "translate:resources": "tsx services/translate/resources/cli.ts",
    "updates": "tsx services/updates/cli.ts",
    "updates:prepare": "tsx services/updates/release-cli.ts",
    "extract": "tsx services/extract/cli.ts",
    "translate:import-cache": "tsx services/translate/import-cache.ts",
    "typecheck:plugins": "tsc --noEmit -p plugins/mv/tsconfig.json && tsc --noEmit -p plugins/rgss/tsconfig.json",
    "build:plugins:mv": "node plugins/mv/build.mjs",
    "build:plugins:rgss": "node plugins/rgss/build.mjs",
    "test:rgss:native": "sh plugins/rgss/native/smoke.sh",
    "test:rgss:e2e": "sh plugins/rgss/native/e2e.sh",
    "build:translate": "node services/translate/build.mjs",
    "build:translate:dev": "node services/translate/build.mjs --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lydell/node-pty": "1.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/analytics": "^2.0.1",
    "bing-translate-api": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3",
    "kuromoji": "^0.1.2",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "shiki": "^4.5.0",
    "socks": "^2.8",
    "tuf-js": "4.1.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7",
    "wordguard": "^0.1.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@jest/globals": "^30.5.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "commitlint-plugin-i18n": "^0.0.1-alpha.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^41.0.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "30",
    "lint-staged": "^15.2.7",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^6"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "engines": {
    "node": ">=22.19.0"
  }
}
