{
  "name": "chaya",
  "version": "0.0.2",
  "private": true,
  "description": "Local-first RPG Maker translation and toolkit",
  "author": "DavidJones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidKk/chaya.git"
  },
  "homepage": "https://github.com/DavidKk/chaya",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "CHAYA_SERVICE=local CHAYA_API_LAN=0 pnpm build:plugins && concurrently -n next,plugins -c blue,magenta \"CHAYA_SERVICE=local CHAYA_API_LAN=0 node scripts/next-listen.mjs dev -p 3927 -H 127.0.0.1\" \"pnpm build:plugins:dev\"",
    "dev:app": "CHAYA_SERVICE=app CHAYA_API_LAN=0 pnpm build:plugins && concurrently -n next,plugins,electron -c blue,magenta,green \"CHAYA_SERVICE=app CHAYA_API_LAN=0 node scripts/next-listen.mjs dev -p 3927 -H 127.0.0.1\" \"pnpm build:plugins:dev\" \"CHAYA_SERVICE=app CHAYA_API_LAN=0 CHAYA_ELECTRON_EXTERNAL=1 node ./node_modules/electron/cli.js .\"",
    "dev:edge": "CHAYA_SERVICE=vercel pnpm build:plugins && concurrently -n next,plugins -c blue,magenta \"CHAYA_SERVICE=vercel node scripts/next-listen.mjs dev -p 3927 -H 0.0.0.0\" \"pnpm build:plugins:dev\"",
    "dev:lan": "CHAYA_SERVICE=local CHAYA_API_LAN=1 pnpm build:plugins && concurrently -n next,plugins -c blue,magenta \"CHAYA_SERVICE=local CHAYA_API_LAN=1 node scripts/next-listen.mjs dev -p 3927 -H 0.0.0.0\" \"pnpm build:plugins:dev\"",
    "dev:edge:lan": "pnpm dev:edge",
    "dev:loopback": "pnpm dev",
    "electron": "CHAYA_SERVICE=app node ./node_modules/electron/cli.js .",
    "electron:open": "CHAYA_SERVICE=app CHAYA_ELECTRON_EXTERNAL=1 node ./node_modules/electron/cli.js .",
    "build": "pnpm build:plugins && pnpm build:next",
    "build:next": "next build --webpack",
    "build:edge": "cross-env CHAYA_TARGET=edge pnpm build",
    "check:edge": "pnpm build:edge && node scripts/check-edge-build.mjs",
    "build:plugins": "node plugins/build.mjs",
    "build:plugins:dev": "node plugins/build.mjs --watch",
    "build:app": "cross-env CHAYA_ELECTRON_BUILD=1 CHAYA_SERVICE=app pnpm build && node scripts/prepare-electron-app.mjs",
    "dist:mac": "pnpm build:app && electron-builder --mac --config electron-builder.yml --publish never && node scripts/package-mac-zip.mjs",
    "dist:win": "pnpm build:app && electron-builder --win --config electron-builder.yml --publish never",
    "dist:dir": "pnpm build:app && electron-builder --dir --config electron-builder.yml --publish never",
    "demo:game": "pnpm build:plugins && node scripts/demo-game.cjs",
    "start": "CHAYA_API_LAN=0 node scripts/next-listen.mjs start -p 3927 -H 127.0.0.1",
    "start:lan": "CHAYA_API_LAN=1 node scripts/next-listen.mjs start -p 3927 -H 0.0.0.0",
    "start:loopback": "pnpm start",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit && pnpm typecheck:plugins",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --config .prettierrc.cjs --write \"**/*.{js,jsx,cjs,ts,tsx,md,json,yml,yaml,mjs,css}\"",
    "format:check": "prettier --config .prettierrc.cjs --check \"**/*.{js,jsx,cjs,ts,tsx,md,json,yml,yaml,mjs,css}\"",
    "lint": "eslint -c eslint.config.mjs --fix .",
    "lint:check": "eslint -c eslint.config.mjs .",
    "ok": "pnpm format && pnpm lint && pnpm typecheck && pnpm test -- --runInBand && pnpm build",
    "ok:full": "pnpm ok",
    "ok:ci": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm test -- --runInBand && pnpm build",
    "translate": "tsx services/translate/cli.ts",
    "extract": "tsx services/extract/cli.ts",
    "translate:import-cache": "tsx services/translate/import-cache.ts",
    "build:preset": "pnpm build:plugins",
    "build:preset:dev": "pnpm build:plugins:dev",
    "plugins:build": "pnpm build:plugins",
    "typecheck:plugins": "tsc --noEmit -p plugins/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vercel/analytics": "^2.0.1",
    "bing-translate-api": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3",
    "kuromoji": "^0.1.2",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.14",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "shadcn": "^4.21.0",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7",
    "wordguard": "^0.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@jest/globals": "^30.5.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "commitlint-plugin-i18n": "^0.0.1-alpha.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^41.0.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "30",
    "lint-staged": "^15.2.7",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^6"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "engines": {
    "node": ">=22.19.0"
  }
}
